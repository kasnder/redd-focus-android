<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Digital Habits: Focus - Light Mode -->
    <style name="Base.Theme.GreaseMilkyway" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - used for app bar, switches, buttons -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimary">@color/primary_blue</item>
        
        <!-- Darker variant of primary - used for status bar, darker UI elements -->
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        
        <!-- Color of text/icons on top of primary color -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_blue</item>
        <item name="colorOnPrimaryContainer">@color/primary_blue</item>
        
        <!-- Background color for the app -->
        <item name="android:windowBackground">@color/background_main</item>
        <item name="android:colorAccent">@color/primary_blue</item>
        
        <!-- Accent color for FABs (Floating Action Buttons) and other accents -->
        <item name="colorSecondary">@color/text_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/accent_green</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorControlActivated">@color/primary_blue</item>
        <item name="colorControlNormal">@color/text_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/surface_light</item>
        <item name="colorOnSurfaceVariant">@color/text_light</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/surface_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/outline_variant</item>
        
        <!-- Text colors for consistency -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_light</item>
        
        <!-- Status bar color (the bar at the very top with time/battery) -->
        <item name="android:statusBarColor">@color/header_bg</item>
        
        <!-- Make status bar icons dark in light mode for better contrast -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.GreaseMilkyway" parent="Base.Theme.GreaseMilkyway" />

    <style name="Theme.GreaseMilkyway.NoActionBar" parent="Base.Theme.GreaseMilkyway">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- Custom toolbar title style with bold text -->
    <style name="ToolbarTitleText" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>
    
    <!-- Custom toolbar title style without bold (for custom rules screen) -->
    <style name="ToolbarTitleTextRegular" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!-- Theme used for the toolbar to control icon tinting -->
    <style name="ToolbarTheme" parent="">
        <item name="colorControlNormal">@color/text_light</item>
    </style>
</resources>
